<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE dictionary SYSTEM "file://localhost/System/Library/DTDs/sdef.dtd">
<dictionary xmlns:xi="http://www.w3.org/2001/XInclude" title="ThockBox Terminology">
    <xi:include href="file:///System/Library/ScriptingDefinitions/CocoaStandard.sdef" xpointer="xpointer(/dictionary/suite[@name='Standard Suite'])"/>
    <suite name="ThockBox Suite" code="Tbox" description="ThockBox sound settings.">
        <class-extension name="application" extends="application" description="ThockBox application.">
            <cocoa class="NSApplication"/>
            <property name="sounds enabled" code="Tben" type="boolean" access="rw" description="Whether keyboard sounds are enabled.">
                <cocoa key="soundsEnabled"/>
            </property>
            <property name="sound pack" code="Tbsp" type="text" access="rw" description="The selected sound pack ID or display name.">
                <cocoa key="soundPack"/>
            </property>
            <property name="sound volume" code="Tbvo" type="real" access="rw" description="Sound volume from 0.0 to 1.0.">
                <cocoa key="soundVolume"/>
            </property>
            <property name="mute during calls" code="Tbmc" type="boolean" access="rw" description="Whether sounds stop while another app uses the microphone (macOS 14.2 or later).">
                <cocoa key="muteDuringCalls"/>
            </property>
            <property name="mute while gaming" code="Tbmg" type="boolean" access="rw" description="Whether sounds stop while a game is in front.">
                <cocoa key="muteWhileGaming"/>
            </property>
            <property name="headphones only" code="Tbho" type="boolean" access="rw" description="Whether sounds stay quiet on speakers and play only through headphones.">
                <cocoa key="headphonesOnly"/>
            </property>
            <property name="mute when locked" code="Tbml" type="boolean" access="rw" description="Whether sounds stop while the screen is locked.">
                <cocoa key="muteWhenLocked"/>
            </property>
            <property name="mute while sharing" code="Tbms" type="boolean" access="rw" description="Whether sounds stop while the screen is shared or recorded.">
                <cocoa key="muteWhileSharing"/>
            </property>
            <property name="automatically muted" code="Tbam" type="boolean" access="r" description="Whether sounds are muted right now by a call, the lock screen, a muted app or inactivity.">
                <cocoa key="automaticallyMuted"/>
            </property>
            <property name="off until" code="Tbou" type="date" access="r" description="When sounds turn back on by themselves after Turn Off for an Hour, or missing value.">
                <cocoa key="offUntil"/>
            </property>
            <property name="mute reason" code="Tbmr" type="text" access="r" description="Why sounds are automatically muted, or empty text when they aren't.">
                <cocoa key="muteReason"/>
            </property>
            <property name="keystrokes today" code="Tbkt" type="integer" access="r" description="Key presses counted today.">
                <cocoa key="keystrokesToday"/>
            </property>
            <property name="keystrokes total" code="Tbka" type="integer" access="r" description="Key presses counted in total.">
                <cocoa key="keystrokesTotal"/>
            </property>
        </class-extension>
    </suite>
</dictionary>
